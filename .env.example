# Copia este archivo como .env y completa tu clave. Nunca subas .env al repositorio.
OPENAI_API_KEY=

# Opcionales
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Precios en USD por millón de tokens de audio, para estimar el costo (mira los precios actuales en openai.com).
# OPENAI_PRICE_IN_PER_M=
# OPENAI_PRICE_OUT_PER_M=

# Detección de turnos (ajusta si el coach se corta solo o responde demasiado rápido)
# VOICE_TURN_MODE=server            # server o semantic
# VOICE_TURN_THRESHOLD=0.75         # 0 a 1; más alto = menos cortes falsos (modo server)
# VOICE_TURN_SILENCE_MS=1500        # silencio antes de que el coach responda (modo server)
# VOICE_TURN_EAGERNESS=low          # low, medium, high o auto (modo semantic)
