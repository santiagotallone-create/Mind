{
  "name": "mind",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Coach de mindfulness con voz e IA: prueba de concepto",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "NODE_ENV=test node --import tsx --test \"src/**/*.test.ts\"",
    "dev:server": "tsx --env-file=.env --watch src/server/index.ts",
